# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда приходят заявки (узнать можно через @userinfobot или getUpdates).
# Команды бота (/start, /history) выполняются только для этого чата
TELEGRAM_CHAT_ID=
# Секрет webhook: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Символы A-Z a-z 0-9 _ -, длина 1–256. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Только для `npm run dev`: 1 — ответы бота печатаются в терминал, а не уходят в Telegram
TELEGRAM_DRY_RUN=

# Supabase: Project Settings → API. Только для сервера, без префикса VITE_
SUPABASE_URL=
# Секретный ключ (sb_secret_...). Никогда не используйте его во frontend-коде
SUPABASE_SECRET_KEY=
# Публичный ключ (sb_publishable_...) — для входа в админку /admin. Попадает в браузер,
# это безопасно: доступ к данным ограничивает RLS (только пользователи из public.admins)
SUPABASE_PUBLISHABLE_KEY=

# AI-агент и embeddings работают через Vercel AI Gateway.
# На Vercel ключ не нужен: функция авторизуется через OIDC автоматически (нужен включённый AI Gateway
# и кредиты в команде Vercel). Локально — ключ AI Gateway (Vercel → AI Gateway → API Keys)
# или свежий VERCEL_OIDC_TOKEN из `vercel env pull` (действует 12 часов).
AI_GATEWAY_API_KEY=
# Необязательно: модель чата и модель embeddings (размерность должна быть 1536)
AI_MODEL=anthropic/claude-haiku-5.5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
