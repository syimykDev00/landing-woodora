# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда приходят заявки (узнать можно через @userinfobot или getUpdates).
# Команды бота (/start, /history) выполняются только для этого чата
TELEGRAM_CHAT_ID=
# Секрет webhook: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Символы A-Z a-z 0-9 _ -, длина 1–256. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Только для `npm run dev`: 1 — ответы бота печатаются в терминал, а не уходят в Telegram
TELEGRAM_DRY_RUN=

# Supabase: Project Settings → API. Только для сервера, без префикса VITE_
SUPABASE_URL=
# Секретный ключ (sb_secret_...). Никогда не используйте его во frontend-коде
SUPABASE_SECRET_KEY=
# Публичный ключ (sb_publishable_...) — для входа в админку /admin. Попадает в браузер,
# это безопасно: доступ к данным ограничивает RLS (только пользователи из public.admins)
SUPABASE_PUBLISHABLE_KEY=

# AI-агент и embeddings — OpenAI API (Responses API). Только сервер: без префикса VITE_.
# Vercel → Project → Settings → Environment Variables → OPENAI_API_KEY (тип Sensitive)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Размерность должна быть 1536 (kb_chunks.embedding vector(1536))
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Необязательно: глубина рассуждений модели (low — дешевле и быстрее) и общий суточный лимит сообщений чата
OPENAI_REASONING_EFFORT=low
CHAT_DAILY_LIMIT=1000
